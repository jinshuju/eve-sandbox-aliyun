{
  "name": "@jinshuju/eve-sandbox-aliyun",
  "version": "0.3.0",
  "description": "Aliyun cloud sandbox (FC Agent Sandbox) provider for eve agents",
  "keywords": [
    "agent",
    "aliyun",
    "e2b",
    "eve",
    "sandbox"
  ],
  "homepage": "https://github.com/jinshuju/eve-sandbox-aliyun#readme",
  "bugs": {
    "url": "https://github.com/jinshuju/eve-sandbox-aliyun/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinshuju/eve-sandbox-aliyun.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "tsx --env-file=.env.local src/integration/aliyun-provider-smoke.ts",
    "sweep": "tsx --env-file=.env.local src/integration/sweep.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "npm run build"
  },
  "dependencies": {
    "e2b": "2.31.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "ai": "^7.0.44",
    "eve": "0.67.0",
    "eve-floor": "npm:eve@0.64.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "eve": ">=0.64.0 <1.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
